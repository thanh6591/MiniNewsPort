# Mini News Portal — local environment example
# Copy this file to `.env` and fill in values.

# --- Database ---
# Postgres (recommended). Use `file:` prefix for the SQLite fallback driver.
DATABASE_URL=postgres://user:pass@localhost:5432/mnp

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Async queues (BullMQ + Redis) ---
# Leave REDIS_URL empty to use the in-process queue adapter (no external broker).
REDIS_URL=
# When set to "1", workers start inside the Nuxt process. Useful for local dev.
# Set to "0" in production and run `pnpm worker` as a separate process.
WORKERS_INPROCESS=1

# --- Scraper limits ---
SCRAPE_MAX_PER_DOMAIN=2
SCRAPE_USER_AGENT=MiniNewsPortalBot/1.0

# --- DLQ email alerts (SMTP) ---
# Leave SMTP_HOST empty to log alerts to the console instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
